// Minimal worker config for integration tests: runtime flags and D1 (compat date pinned to the workerd build bundled
  // with @cloudflare/vitest-pool-workers; production uses the newest date)
// binding as production, but without the assets pipeline (built assets do
// not exist when tests run) and with a throwaway local database id.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "dakholvakharj-test",
  "main": "../src/worker/index.ts",
  "compatibility_date": "2026-08-22",
    "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "BETTER_AUTH_SECRET": "test-secret-do-not-use-in-production-0123456789",
    "APP_URL": "http://localhost:8787",
    "AUTH_RATE_LIMIT_MAX": "100000",
    "AUTH_RATE_LIMIT_OFF": "1"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dakholvakharj-test",
      "database_id": "local-test",
      "migrations_dir": "../drizzle"
    }
  ]
}
